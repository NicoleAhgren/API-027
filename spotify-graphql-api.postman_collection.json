  "item": [
    {
      "name": "Register user - success",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "pm.environment.set(\"randomUsername\", \"testuser_\" + Date.now());"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"Response has token\", function () {\r",
              "    const json = pm.response.json();\r",
              "    pm.expect(json.data.register.token).to.be.a('string');\r",
              "});\r",
              "\r",
              "pm.test(\"Response has user\", function () {\r",
              "    const json = pm.response.json();\r",
              "    pm.expect(json.data.register.user.username).to.be.a('string');\r",
              "});\r",
              "\r",
              "// Save token for later requests\r",
              "const json = pm.response.json();\r",
              "if (json.data && json.data.register) {\r",
              "    pm.environment.set(\"token\", json.data.register.token);\r",
              "    pm.environment.set(\"userId\", json.data.register.user.id);\r",
              "}"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "graphql",
          "graphql": {
            "query": "mutation {\r\n  register(username: \"{{randomUsername}}\", password: \"Test1234!\") {\r\n    token\r\n    user {\r\n      id\r\n      username\r\n    }\r\n  }\r\n}",
            "variables": ""
          }
        },
        "url": {
          "raw": "{{baseUrl}}",
          "host": [
            "{{baseUrl}}"
          ]
        }
